<%
    // เพิ่มเมนูที่นี่: label = ชื่อเมนู · url = path ของหน้า (เมนูแสดงแค่ข้อความ ไม่มีไอคอน)
    const menu = [
        { label: 'Dashboard', url: '/dashboard' },
        { label: 'Timesheet', url: '/worktime' },
        { label: 'Tasks', url: '/tasks' },
        { label: 'Calendar', url: '/calendar' },
        { label: 'Chatbot', url: '/chat' },
    ];
    const path = locals.currentPath || '';
%>
<aside class="sidebar">
  <a href="/" class="sidebar-brand">
    <span class="brand-mark"><img src="/images/logo-mark.png" alt="" /></span>
    <span>
      <span class="brand-name">FRICTION</span>
      <span class="brand-full">Friction Company</span>
    </span>
  </a>

  <nav class="sidebar-nav" aria-label="เมนูหลัก">
    <div class="nav-heading">Menu</div>
    <% menu.forEach(function (item) {
         const active = path === item.url || path.startsWith(item.url + '/'); %>
      <a href="<%= item.url %>" class="nav-link<%= active ? ' active' : '' %>"<%- active ? ' aria-current="page"' : '' %>>
        <span><%= item.label %></span>
      </a>
    <% }) %>
  </nav>

  <form method="POST" action="/auth/logout" class="sidebar-footer">
    <button type="submit" class="nav-link nav-logout">
      <%- include('icon', { name: 'logout' }) %>
      <span>Logout</span>
    </button>
  </form>
</aside>
